# Tudo opcional. Copie para .env e preencha só o que for usar.

# Criar alertas com IA (painel "Criar alerta") — chave do Ollama Cloud.
OLLAMA_API_KEY=
# OLLAMA_MODEL=deepseek-v4.1-flash

# Gerar a fala por texto (botão ⌨ no painel de áudios) — chave do Fish Audio.
FISH_API_KEY=

# Cliente do LoL instalado fora de C:/ ou D:/Riot Games/League of Legends
# LOL_LOCKFILE=E:/Riot Games/League of Legends/lockfile

# Luzes: escolher o dispositivo por trecho do nome quando o OpenRGB lista mais
# de um do mesmo tipo (sem isto usa o primeiro teclado/RAM/placa-mãe).
# RGB_TECLADO=Alloy
# RGB_RAM=Kingston
# RGB_PLACA=ASUS

# Portas (padrão 7777 draft, 7778 tela, 7779 luzes)
# DRAFT_PORT=7777
# INGAME_PORT=7778
# RGB_PORT=7779

# 1 = sobe com a voz ligada (o padrão é desligada; o botão da página liga)
# COACH_VOZ=1

# 0 = nao abrir o OpenRGB que vem no pacote (use o seu, com o SDK Server ligado)
# OPENRGB_AUTO=0
